# ===== MIDAD / RKPOS — Environment template =====
# انسخ إلى .env (غير متتبع في git) واملأ ما تحتاجه فقط. لا تضع مفاتيح في أي ملف متتبع.

# Contact (Crossref/OpenAlex polite pool)
RKPOS_CONTACT_EMAIL=

# Model providers (Model Adapter Layer) — يكفي مزود واحد للبدء؛ مزود ثانٍ مختلف يضمن استقلال المراجعة
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LOCAL_LLM_BASE_URL=          # e.g. http://localhost:11434/v1 (Ollama)
LOCAL_LLM_API_KEY=

# Reference management
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user     # user | group
S2_API_KEY=

# Knowledge base / RAG
VECTOR_DB_URL=               # e.g. postgresql://.../midad (pgvector)
EMBEDDING_MODEL=

# Google Drive (programmatic mode only; connector mode needs none)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Integrity
SIMCHECK_API_KEY=

# Optional
OBSIDIAN_VAULT_PATH=
NOTION_TOKEN=
